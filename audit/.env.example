# Public URL. Use http://127.0.0.1:5173 for local development.
APP_URL=https://audit.zoomi.co
NODE_ENV=production
HOST=127.0.0.1
PORT=4310
AUDIT_DATA_DIR=/var/lib/zoomi-audit

# Separate random values, each at least 32 characters. Store production secrets
# in the deployment platform's secret store, never in Git.
BETTER_AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=

# Zoomi-owned Google OAuth web application. The callback is:
# https://audit.zoomi.co/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe restricted key, subscription Price ID, and signed webhook secret.
# The webhook is https://audit.zoomi.co/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Verified sender for account verification and password recovery.
RESEND_API_KEY=
EMAIL_FROM=Audit by Zoomi <accounts@zoomi.co>

# Optional licensed competitor data. The daily request allowance is a hard cap.
# Keep it at 0 until a spend budget and provider account are approved.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_DAILY_REQUEST_LIMIT=0
